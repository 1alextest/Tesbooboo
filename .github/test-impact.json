  "rules": [
    {"id":"shared-e2e-harness","patterns":["e2e/global-setup.ts","e2e/utils/**","e2e/**/fixtures/**","e2e/**/fixtures.*","e2e/playwright*.config.*","e2e/package*.json"],"domains":["*"],"reason":"Shared E2E provisioning, utilities, fixtures, Playwright configuration and dependencies can invalidate every domain's test evidence; select the full configured cross-system impact set without collecting/importing fixtures."},
    {"id":"legacy-shared-owner","patterns":["Tesbo-Backend-Nest/src/legacy/legacy.service.ts","Tesbo-Backend-Nest/src/legacy/legacy.controller.ts","Tesbo-Backend-Nest/src/legacy/legacy.module.ts","Tesbo-Backend-Nest/src/legacy/test-helpers/**"],"domains":["*"],"reason":"LegacyService owns many unrelated native domains and their REST/MCP/worker consumers; never map it to Zyra alone."},
    {"id":"database-shared-owner","patterns":["Tesbo-Backend-Nest/migrations/**","Tesbo-Backend-Nest/src/database/**","Tesbo-Backend-Nest/scripts/ci/**"],"domains":["*"],"reason":"Schema, transactions and migrations can affect every reader/writer; static imports cannot establish table-level impact."},
    {"id":"backend-auth","patterns":["Tesbo-Backend-Nest/src/auth/**","Tesbo-Backend-Nest/src/legacy/signup*"],"domains":["identity","membership","notifications","onboarding"],"reason":"Existing shared authentication, credentials, account and invitation owners."},
    {"id":"backend-billing","patterns":["Tesbo-Backend-Nest/src/billing/**","Tesbo-Backend-Nest/src/plan-limits/**"],"domains":["entitlements"],"reason":"Billing lifecycle and project write locks; Test Plans alone cannot verify subscription entitlement."},
    {"id":"backend-automation","patterns":["Tesbo-Backend-Nest/src/automation/**"],"domains":["automation","executions","attachments"],"reason":"Automation results, retries, closing and evidence reach native Runs and the optional reporter."},
    {"id":"backend-mcp","patterns":["Tesbo-Backend-Nest/src/mcp/**"],"domains":["mcp","rest","identity","membership"],"reason":"MCP transport/tool schemas dispatch into shared native domain services."},
    {"id":"backend-graph","patterns":["Tesbo-Backend-Nest/src/behavior-graph/**"],"domains":["model-studio","zyra","testcases","executions"],"reason":"Current development owns graph/source/model review and downstream linked cases/Runs here."},
    {"id":"backend-review-board","patterns":["Tesbo-Backend-Nest/src/review-board/**"],"domains":["review-board","testcases","entitlements"],"reason":"Review Board processor, service, HTTP adapter and native review consumers need actual DB/Redis evidence."},
    {"id":"backend-sync-worker","patterns":["Tesbo-Backend-Nest/src/integration-sync/**"],"domains":["integrations","knowledge","zyra","notifications"],"reason":"Provider sync is a worker/persistence/projection path, not only a REST integration."},
    {"id":"backend-rag-worker","patterns":["Tesbo-Backend-Nest/src/rag/**"],"domains":["rag","knowledge","testcases","zyra"],"reason":"Embedding jobs derive searchable context from KB/cases and feed retrieval."},
    {"id":"backend-report-worker","patterns":["Tesbo-Backend-Nest/src/analytics-report/**"],"domains":["reports","notifications"],"reason":"Scheduled report delivery consumes native metrics and has external retry/receipt implications."},
    {"id":"backend-welcome-worker","patterns":["Tesbo-Backend-Nest/src/welcome-email/**"],"domains":["notifications","identity","onboarding"],"reason":"Queue-based welcome delivery depends on signup and account state."},
    {"id":"backend-archive-worker","patterns":["Tesbo-Backend-Nest/src/zyra-archive-sweep/**"],"domains":["zyra","notifications"],"reason":"Background archive state is consumed by native assistant/task surfaces."},
    {"id":"backend-kb-worker","patterns":["Tesbo-Backend-Nest/src/legacy/kb-*","Tesbo-Backend-Nest/src/legacy/knowledge-*"],"domains":["knowledge","rag"],"reason":"KB extraction/history and file workers affect document and retrieval consumers."},
    {"id":"backend-zyra","patterns":["Tesbo-Backend-Nest/src/legacy/zyra-*"],"domains":["zyra","testcases","integrations","rag"],"reason":"Zyra helpers stage and publish through existing case/integration/KB owners."},
    {"id":"backend-repository","patterns":["Tesbo-Backend-Nest/src/legacy/testcase-*","Tesbo-Backend-Nest/src/legacy/repository-*","Tesbo-Backend-Nest/src/legacy/suite-*"],"domains":["testcases","executions","mcp"],"reason":"Repository edits and suite ownership feed Run attachment and MCP reads/writes."},
    {"id":"backend-run-plan","patterns":["Tesbo-Backend-Nest/src/legacy/execution-*","Tesbo-Backend-Nest/src/legacy/run-*","Tesbo-Backend-Nest/src/legacy/approved-run-*","Tesbo-Backend-Nest/src/legacy/plan-*","Tesbo-Backend-Nest/src/legacy/manual-evidence-*","Tesbo-Backend-Nest/src/legacy/history-import-*"],"domains":["plans","executions","automation","reports"],"reason":"Plan/Run lineage, approval, historical results and attribution have native/report/SDK consumers."},
